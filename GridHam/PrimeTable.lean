def primeShapes : List (ℕ × ℕ) :=
  [(1, 1), (1, 2), (1, 3), (2, 1), (2, 2), (2, 3), (3, 1), (3, 2), (3, 3), (4, 4), (4, 5), (5, 4)]

def primeTable : List (ℕ × ℕ × List (Coord × Coord × List Coord)) :=
  [(1, 1, primePaths_1x1), (1, 2, primePaths_1x2), (1, 3, primePaths_1x3), (2, 1, primePaths_2x1), (2, 2, primePaths_2x2), (2, 3, primePaths_2x3), (3, 1, primePaths_3x1), (3, 2, primePaths_3x2), (3, 3, primePaths_3x3), (4, 4, primePaths_4x4), (4, 5, primePaths_4x5), (5, 4, primePaths_5x4)]

/-- The stored path for `(w, h, s, t)`, or `[]` if there is none. -/
def primeLookup (w h : ℕ) (s t : Coord) : List Coord :=
  match primeTable.find? (fun e => e.1 == w && e.2.1 == h) with
  | none => []
  | some e =>
    match e.2.2.find? (fun x => x.1 == s && x.2.1 == t) with
    | none => []
    | some x => x.2.2

set_option maxRecDepth 100000 in
/-- Every acceptable problem on a prime shape has a valid stored path. -/
theorem prime_check : ∀ wh ∈ primeShapes, ∀ s ∈ allCoords wh.1 wh.2,
    ∀ t ∈ allCoords wh.1 wh.2, s ≠ t → IsAcceptable wh.1 wh.2 s t →
    ValidPath wh.1 wh.2 s t (primeLookup wh.1 wh.2 s t) := by
  decide +kernel

/-- **Base case.** Acceptable problems on prime shapes are solvable. -/
theorem prime_solvable (w h : ℕ) (s t : Coord) (hshape : (w, h) ∈ primeShapes)
    (hs : InBounds w h s) (ht : InBounds w h t) (hst : s ≠ t)
    (hacc : IsAcceptable w h s t) : HasHamPath w h s t :=
  ⟨primeLookup w h s t,
    prime_check (w, h) hshape s ((mem_allCoords w h s).mpr hs)
      t ((mem_allCoords w h t).mpr ht) hst hacc⟩

end GridHam
