/-- All ordered pairs of distinct vertices of the grid. -/
def pairsOf (w h : ℕ) : List (Coord × Coord) :=
  (allCoords w h).flatMap (fun s =>
    ((allCoords w h).filter (fun t => t ≠ s)).map (fun t => (s, t)))

def mismatches : List (ℕ × ℕ × Coord × Coord) :=
  truth.flatMap (fun (w, h, pos) =>
    (pairsOf w h).filterMap (fun (s, t) =>
      if decide (IsAcceptable w h s t) == pos.contains (s, t) then none
      else some (w, h, s, t)))

def numChecked : ℕ :=
  (truth.map (fun (w, h, _) => (pairsOf w h).length)).sum

#eval s!"cross-check: {numChecked} instances, {mismatches.length} mismatches: {mismatches.take 20}"

#guard numChecked == 10532
#guard mismatches.isEmpty

end GridHam.CrossCheck
